# Server-side API keys for Trunk Room Express server
# Copy this file to ../.env (root) and fill in your keys.
# The root .env is loaded by both Vite (VITE_* vars) and the server (dotenv).

# OpenAI API key — used by /api/analyze-clothing (GPT-4o Vision)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# remove.bg API key — used by /api/remove-background
# https://www.remove.bg/api
# Free tier: 50 credits/month. 1 credit = 1 image.
REMOVE_BG_API_KEY=...

# Optional: change the server port (default 3001)
# API_PORT=3001
